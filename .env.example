# Server
NODE_ENV=development
PORT=4000

# CORS
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Dev: Postgres vive en el VPS (contenedor agentemovilco-postgres), NUNCA expuesto a
# internet. Se accede vía túnel SSH: abre tu túnel hacia 127.0.0.1:5436 en el VPS
# (apex-vps) mapeado a un puerto local (ej. 5436) y usa esa URL aquí.
# Prod: en el VPS, el backend corre en la misma red docker que Postgres y se conecta
# por el nombre del contenedor (agentemovilco-postgres:5432) en vez de vía túnel.
DATABASE_URL="postgresql://agentemovilco_dev:password@127.0.0.1:5436/agentemovilco_dev?schema=public"

# Logging
LOG_LEVEL=debug
